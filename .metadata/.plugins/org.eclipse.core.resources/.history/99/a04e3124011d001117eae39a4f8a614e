spring.application.name=apigateway

server.port=8085

eureka.client.service-url.defaultZone=http://localhost:8761/eureka

spring.cloud.gateway.server.webflux.routes[0].id=Book_store_inventory
spring.cloud.gateway.server.webflux.routes[0].uri=lb://book_store_inventory
spring.cloud.gateway.server.webflux.routes[0].predicates=Path=/api/books/**

spring.cloud.gateway.server.webflux.routes[1].id=StudentREST
spring.cloud.gateway.server.webflux.routes[1].uri=lb://studentREST
spring.cloud.gateway.server.webflux.routes[1].predicates=Path=/restAPI/student/**

spring.cloud.discovery.enabled=true